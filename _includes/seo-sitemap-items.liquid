{%- assign site_base = site.platform.site_url | default: site.url -%}
{%- assign public_pages = site.pages | where_exp: "item", "item.sitemap != false and item.indexable != false and item.test_only != true" | where_exp: "item", "item.layout == 'default' or item.layout == 'campaign'" -%}
{%- assign public_campaigns = site.campaigns | where_exp: "item", "item.test_only != true and item.preview_only != true and item.published != false and item.sitemap != false and item.indexable != false" -%}
{%- assign public_items = public_pages | concat: public_campaigns -%}
{%- for item in public_items -%}
  {%- if item.translation_key == 'community_index' and site.seo.index_public_community_hub == false -%}
    {%- continue -%}
  {%- endif -%}
  {%- if include.format == 'text' -%}
    {%- include seo-sitemap-url.txt item=item site_base=site_base -%}
  {%- else -%}
    {%- include seo-sitemap-url.xml item=item -%}
  {%- endif -%}
{%- endfor -%}
