{
  "name": "pool",
  "version": "1.2.11",
  "description": "**Dust Wave's open crowdfunding platform** — [pool.dustwave.xyz](https://pool.dustwave.xyz)",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "deploy:worker": "npm --prefix worker run deploy",
    "test": "vitest run && ./scripts/test-e2e.sh",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:content-security": "node ./scripts/audit-campaign-content.mjs",
    "test:seo": "node ./scripts/audit-seo.mjs",
    "test:crawl-endpoints": "node ./scripts/audit-crawl-endpoints.mjs",
    "test:secrets": "node ./scripts/audit-secrets.mjs",
    "test:i18n": "ruby ./scripts/check-i18n-completeness.rb",
    "test:premerge": "./scripts/pre-merge-regression.sh",
    "release:smoke": "./scripts/release-smoke.sh",
    "release:a11y-evidence": "./scripts/release-a11y-evidence.sh",
    "release:i18n-seo-evidence": "node ./scripts/release-i18n-seo-evidence.mjs",
    "release:pledge-evidence": "node ./scripts/release-pledge-evidence.mjs",
    "release:screen-reader-evidence": "node ./scripts/release-screen-reader-evidence.mjs",
    "release:providers": "node ./scripts/release-provider-checks.mjs",
    "release:payment-smoke": "node ./scripts/release-payment-smoke.mjs",
    "test:e2e": "./scripts/test-e2e.sh",
    "test:e2e:quick": "playwright test --headed",
    "test:e2e:headless": "CI=1 playwright test",
    "test:e2e:headless:podman": "CI=1 ./scripts/podman-playwright-run.sh npx playwright test --workers=1",
    "test:e2e:parity": "CI=1 playwright test tests/e2e/campaign-checkout.spec.ts tests/e2e/manage-flows.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "sync:worker-config": "ruby ./scripts/sync-worker-config.rb",
    "setup:deploy": "node ./scripts/setup-deploy.mjs",
    "backup:inventory:audit": "node ./scripts/audit-pool-data-inventory.mjs",
    "backup:plan": "node ./scripts/pool-backup.mjs --dry-run",
    "backup:snapshot": "node ./scripts/pool-backup.mjs",
    "backup:readiness": "node ./scripts/pool-backup-readiness.mjs",
    "backup:retention": "node ./scripts/pool-backup-retention.mjs",
    "backup:offsite": "node ./scripts/pool-backup-offsite-copy.mjs",
    "restore:plan": "node ./scripts/pool-restore.mjs",
    "restore:rehearse": "node ./scripts/rehearse-pool-restore.mjs",
    "recovery:traffic-preflight": "node ./scripts/pool-recovery-traffic-preflight.mjs",
    "recovery:reconcile": "node ./scripts/pool-recovery-reconciliation.mjs",
    "cloudflare:admin-response-rule": "node ./scripts/configure-cloudflare-admin-response-rule.mjs",
    "performance:budget": "node ./scripts/audit-performance-budgets.mjs",
    "test:performance:budgets": "node ./scripts/audit-performance-budgets.mjs",
    "test:performance:lighthouse": "./scripts/podman-stack-run.sh node ./scripts/performance-lighthouse.mjs",
    "test:performance:lighthouse:host": "node ./scripts/performance-lighthouse.mjs",
    "test:performance:runtime": "node ./scripts/audit-runtime-performance.mjs",
    "test:cache-policy": "node ./scripts/audit-cache-policy.mjs",
    "production:posture": "node ./scripts/audit-production-posture.mjs",
    "localization:review": "node ./scripts/localization-review.mjs",
    "secrets:dev": "./scripts/configure-dev-secrets.sh",
    "podman:doctor": "./scripts/podman-doctor.sh",
    "podman:self-check": "./scripts/podman-self-check.sh",
    "test:security": "vitest run --config vitest.security.config.mts",
    "test:security:podman": "./scripts/podman-stack-run.sh npx vitest run --config vitest.security.config.mts",
    "test:security:staging": "WORKER_URL=https://pledge-staging.dustwave.xyz vitest run --config vitest.security.config.mts",
    "test:usps": "node ./scripts/usps-smoke.mjs",
    "shipping-countries:check": "node ./shared/dust-wave-platform/packages/shipping-core/bin/sync-shipping-countries.mjs ./_data/shipping_countries.yml",
    "shipping-countries:sync": "node ./shared/dust-wave-platform/packages/shipping-core/bin/sync-shipping-countries.mjs ./_data/shipping_countries.yml --write",
    "assets:minify": "node ./shared/dust-wave-platform/packages/build-core/bin/minify-site-assets.mjs --write",
    "assets:minify:check": "node ./shared/dust-wave-platform/packages/build-core/bin/minify-site-assets.mjs --check",
    "media:optimize": "node ./scripts/optimize-media.mjs --write",
    "media:optimize:check": "node ./scripts/optimize-media.mjs --check",
    "media:manifest": "node ./scripts/optimize-media.mjs --write --manifest-only",
    "media:optimize:podman": "./scripts/podman-media-optimize.sh --write",
    "media:optimize:check:podman": "./scripts/podman-media-optimize.sh --check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || ^26.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "lighthouse": "13.4.1",
    "smol-toml": "^1.7.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "ip-address": "10.4.0",
    "undici": "7.29.0"
  }
}
