# Local Worker defaults. Copy to worker/.dev.vars for machine-specific secrets,
# or run `npm run secrets:dev`.
# The dev launchers can generate missing local signing secrets.
#
# Keep this file aligned with the keys used in worker/.dev.vars, but never put
# real secret values here.

# Local routing / mode.
APP_MODE=test
SITE_BASE=http://127.0.0.1:4000
WORKER_BASE=http://127.0.0.1:8787
CANONICAL_SITE_BASE=http://127.0.0.1:4000
CANONICAL_WORKER_BASE=http://127.0.0.1:8787
CORS_ALLOWED_ORIGIN=http://127.0.0.1:4000
SNIPCART_MODE=test

# Local admin access.
ADMIN_BOOTSTRAP_EMAILS=alonso@dustwave.xyz
ADMIN_TEST_CAMPAIGNS=hand-relations,smoke-editable

# Required local secrets.
ADMIN_SECRET=
ADMIN_SESSION_SECRET=
CHECKOUT_INTENT_SECRET=
MAGIC_LINK_SECRET=
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY_TEST=
STRIPE_WEBHOOK_SECRET=

# Optional local deploy/provider credentials.
GITHUB_TOKEN=
CLOUDFLARE_API_TOKEN=
USPS_ENABLED=false
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
